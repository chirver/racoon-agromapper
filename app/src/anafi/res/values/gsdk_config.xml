<?xml version="1.0" encoding="utf-8"?>
<!--
  Racoon AgroMapper: ajustes de GroundSDK distintos de los valores por defecto oficiales
  (third_party/groundsdk/res/*/values/config.xml). Se aplican como capa encima de ellos.
  Sin envío de datos a servidores: ni informes de fallos, ni registros de vuelo, ni firmware, ni efemérides.
-->
<resources>
    <bool name="gsdk_blackbox_enabled">false</bool>
    <bool name="gsdk_crash_report_enabled">false</bool>
    <bool name="gsdk_ephemeris_sync_enabled">false</bool>
    <bool name="gsdk_firmware_enabled">false</bool>
    <bool name="gsdk_flight_data_enabled">false</bool>
    <bool name="gsdk_flight_log_enabled">false</bool>
    <bool name="gsdk_gutma_log_enabled">false</bool>
    <!-- Los ajustes del dron no se guardan en el móvil ni se reenvían al conectar -->
    <string name="gsdk_offline_settings_mode">OFF</string>
</resources>
